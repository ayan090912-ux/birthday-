# Persistent Cloud Music Synchronization (AWS S3)
# Note: AWS credentials can be placed in ~/.aws/credentials or specified below:
AWS_REGION=ap-south-1
AWS_S3_BUCKET=anshika-birthday-music-vault
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Live Production Cloud Manifest URL (loaded by FloatingPillPlayer on deployed website)
VITE_CLOUD_MANIFEST_URL=https://anshika-birthday-music-vault.s3.ap-south-1.amazonaws.com/music-manifest.json
